# Configurações do Banco de Dados PostgreSQL
POSTGRES_DB=raizes_db
POSTGRES_USER=raizes_app
POSTGRES_PASSWORD=secret_password
POSTGRES_PORT=5432

# Configurações do Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Configurações do RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Configurações da Aplicação
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=SuaChaveSecretaSuperSeguraParaTokenJWT2026

PORT=3333
DATABASE_URL=postgresql://raizes_app:secret_password@localhost:5433/raizes_db